; VU1 textured geometry transform for the split input/output bank contract.
;
; Input TOPS bank:
;   QW 0      control (vertex count in X)
;   QW 1..2   viewport/depth scale and offset
;   QW 3..5   prefix, vertex and suffix GIF tags
;   QW 6..10  five A+D prefix records, padded with GS NOP writes
;   QW 11..   clip XYZW, STQ/control and RGBA per vertex
;   final QW  one A+D suffix record, padded with a GS NOP write
;
; Output is written 512 QW above TOP, so each input bank has a disjoint
; 256-QW GIF PACKED output bank. STQ is emitted before RGBAQ so GIF captures Q
; for perspective-correct texture sampling.

	.vu
	.align 4
	.global Ps2GsVu1TexturedTransformCodeStart
	.global Ps2GsVu1TexturedTransformCodeEnd
Ps2GsVu1TexturedTransformCodeStart:
	NOP                             xtop          VI02
	NOP                             NOP
	NOP                             NOP
	NOP                             NOP
	NOP                             NOP
	NOP                             lq            VF01,1(VI02)
	NOP                             lq            VF02,2(VI02)
	NOP                             ilw.x         VI05,0(VI02)
	NOP                             iaddiu        VI03,VI02,0x0006
	NOP                             iaddiu        VI04,VI02,0x0200
	NOP                             iaddiu        VI10,VI04,0x0000

	NOP                             lq            VF07,3(VI02)
	NOP                             sqi           VF07,(VI04++)
	NOP                             lqi           VF07,(VI03++)
	NOP                             sqi           VF07,(VI04++)
	NOP                             lqi           VF07,(VI03++)
	NOP                             sqi           VF07,(VI04++)
	NOP                             lqi           VF07,(VI03++)
	NOP                             sqi           VF07,(VI04++)
	NOP                             lqi           VF07,(VI03++)
	NOP                             sqi           VF07,(VI04++)
	NOP                             lqi           VF07,(VI03++)
	NOP                             sqi           VF07,(VI04++)

	NOP                             lq            VF07,4(VI02)
	NOP                             sqi           VF07,(VI04++)

vertexLoop:
	NOP                             lqi           VF03,(VI03++)
	NOP                             lqi           VF04,(VI03++)
	NOP                             lqi           VF05,(VI03++)
	NOP                             div           Q,VF00w,VF03w
	NOP                             NOP
	NOP                             NOP
	NOP                             NOP
	NOP                             NOP
	NOP                             NOP
	NOP                             NOP
	mulq.xyz      VF03,VF03,Q       NOP
	NOP                             NOP
	NOP                             NOP
	NOP                             NOP
	maxz.z        VF03,VF03,VF00z   NOP
	NOP                             NOP
	NOP                             NOP
	NOP                             NOP
	miniw.z       VF03,VF03,VF00w   NOP
	NOP                             NOP
	NOP                             NOP
	NOP                             NOP
	mulaw.xyz     ACC,VF02,VF00w    NOP
	madd.xyz      VF06,VF03,VF01    NOP
	mul.w         VF06,VF04,VF00    NOP
	NOP                             NOP
	NOP                             NOP
	ftoi4.xy      VF06,VF06         NOP
	ftoi0.z       VF06,VF06         NOP
	mulq.xyz      VF04,VF04,Q       isubiu        VI05,VI05,1
	NOP                             NOP
	NOP                             NOP
	NOP                             NOP
	NOP                             sqi           VF04,(VI04++)
	NOP                             sqi           VF05,(VI04++)
	NOP                             ibne          VI05,VI00,vertexLoop
	NOP                             sqi           VF06,(VI04++)

	NOP                             lq            VF07,5(VI02)
	NOP                             sqi           VF07,(VI04++)
	NOP                             lqi           VF07,(VI03++)
	NOP                             sqi           VF07,(VI04++)
	NOP                             xgkick        VI10
	NOP[E]                          NOP
	NOP                             NOP
	.align 4
Ps2GsVu1TexturedTransformCodeEnd:
